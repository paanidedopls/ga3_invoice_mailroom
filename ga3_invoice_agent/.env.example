# Exact public Q2 base URL; after obtaining a stable ngrok domain, use:
# A2A_BASE_URL=https://YOUR-ASSIGNED-DOMAIN.ngrok-free.dev/a2a/
A2A_BASE_URL=http://localhost:8000/a2a/
DB_PATH=./data/state.sqlite3
OPENAI_BASE_URL=https://aipipe.org/openai/v1
OPENAI_API_KEY=put-your-aipipe-token-in-local-env-only
OPENAI_MODEL=gpt-6-luna
AI_TIMEOUT_SECONDS=36
